{
  "name": "nearium-desktop-deployer",
  "version": "0.1.0",
  "private": true,
  "description": "Nearium dedicated NEAR testnet factory deployer",
  "main": "src/main.cjs",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "check": "node --check src/main.cjs && node --check src/preload.cjs && node --check src/renderer.js && node --check src/plan.cjs",
    "dist": "electron-builder --win portable --x64 --publish never"
  },
  "dependencies": {
    "near-api-js": "7.4.0"
  },
  "devDependencies": {
    "electron": "44.10.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "fun.nearium.testnet.deployer",
    "productName": "Nearium Desktop Deployer",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Nearium-Deployer-Portable-${version}.${ext}"
    }
  }
}
